{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-package-manifest.v0.2.json",
  "title": "Automation Auditor User-Completion Task Package v0.2",
  "description": "No answer key or business scoring. Runtime additionally requires unique basenames and instructions_file to match a non-empty input file; criteria reference is that file's SHA-256.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "task_id", "task_version", "display_name", "task_kind", "description", "review_as_of", "created_at", "input_files", "completion_criteria"],
  "properties": {
    "schema_version": {"const": "benchmark-package-manifest-v0.2"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "task_version": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "task_kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "description": {"type": "string", "minLength": 1},
    "review_as_of": {"type": "string", "format": "date"},
    "created_at": {"type": "string", "format": "date-time"},
    "completion_criteria": {
      "type": "object", "additionalProperties": false,
      "required": ["basis", "instructions_file"],
      "properties": {
        "basis": {"const": "user_confirmation"},
        "instructions_file": {"type": "string", "minLength": 1}
      }
    },
    "input_files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "media_type", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\u0000)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\/$).+$"},
          "media_type": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
