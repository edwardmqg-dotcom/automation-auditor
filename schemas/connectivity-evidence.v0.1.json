{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connectivity-evidence.v0.1.json",
  "title": "Automation Auditor Connectivity Evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "automation_manifest_id", "adapter_type", "target_url", "started_at", "completed_at", "outcome", "verification_method", "http_status", "note"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "automation_manifest_id": {"type": "string", "minLength": 1},
    "adapter_type": {"enum": ["guided", "events", "api"]},
    "target_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "outcome": {"enum": ["pending_manual_confirmation", "verified", "failed"]},
    "verification_method": {"enum": ["guided_handoff", "unauthenticated_head"]},
    "http_status": {"oneOf": [{"type": "integer", "minimum": 100, "maximum": 599}, {"type": "null"}]},
    "note": {"type": "string", "minLength": 1}
  }
}
