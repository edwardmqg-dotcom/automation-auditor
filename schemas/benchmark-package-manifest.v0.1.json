{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-package-manifest.v0.1.json",
  "title": "Automation Auditor Benchmark Package Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "task_id", "task_version", "display_name", "task_kind", "description", "rubric_ref", "review_as_of", "acceptance", "input_files", "reference_answers", "created_at"],
  "properties": {
    "schema_version": { "const": "benchmark-package-manifest-v0.1" },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_version": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "task_kind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "rubric_ref": { "type": "string", "minLength": 1 },
    "review_as_of": { "type": "string", "format": "date" },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_count"],
      "properties": { "requirement_count": { "type": "integer", "minimum": 1 } }
    },
    "input_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "media_type": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "reference_answers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_in_package", "mode", "reference_set_id", "unlock_policy"],
      "properties": {
        "included_in_package": { "const": false },
        "mode": { "const": "sealed_external" },
        "reference_set_id": { "type": "string", "minLength": 1 },
        "unlock_policy": { "const": "after_output_submission" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
