{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation-auditor.local/schemas/ai-analysis-evidence.v0.1.json",
  "title": "Automation Auditor AI Analysis Evidence v0.1",
  "type": "object",
  "required": ["status", "call_evidence"],
  "properties": {
    "status": { "enum": ["succeeded", "unavailable", "failed"] },
    "error": { "type": "string" },
    "analysis": {
      "type": "object",
      "required": ["executive_summary", "comparison_scope", "findings", "residual_human_work", "recommended_next_experiment", "limitations"],
      "properties": {
        "executive_summary": { "type": "string", "minLength": 1 },
        "comparison_scope": { "enum": ["single_run", "multi_run"] },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["title", "observation", "interpretation", "confidence", "evidence_refs"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "observation": { "type": "string", "minLength": 1 },
              "interpretation": { "type": "string", "minLength": 1 },
              "confidence": { "enum": ["high", "medium", "low"] },
              "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "residual_human_work": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["work", "why_it_remains", "evidence_refs"],
            "properties": {
              "work": { "type": "string", "minLength": 1 },
              "why_it_remains": { "type": "string", "minLength": 1 },
              "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "recommended_next_experiment": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "call_evidence": {
      "type": "object",
      "required": ["provider", "model", "prompt_version", "model_call_made"],
      "properties": {
        "provider": { "const": "Nebius Token Factory" },
        "model": { "type": "string", "minLength": 1 },
        "endpoint_origin": { "type": "string", "format": "uri" },
        "prompt_version": { "const": "evidence-analyst-v0.1" },
        "model_call_made": { "type": "boolean" },
        "http_status": { "type": ["integer", "null"] },
        "request_id": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "input_run_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
