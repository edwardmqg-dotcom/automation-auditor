# Wrangler-compatible local server secrets. Copy to .dev.vars and keep the real file untracked.
NEBIUS_ANALYST_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Blanks deliberately block calls. Configure the reviewer gate separately.
ANALYST_REVIEWER_TOKEN_SHA256=
ANALYST_PRICING_VERSION=
ANALYST_PRICING_VERIFIED_AT=
ANALYST_PRICING_VALID_UNTIL=
# A D1 binding named ANALYST_BUDGET_DB must be provisioned and migrated separately.
